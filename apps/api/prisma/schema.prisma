generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  name       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  businesses Business[]
}

model Business {
  id               String            @id @default(cuid())
  name             String
  ownerId          String?
  owner            User?             @relation(fields: [ownerId], references: [id])
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  bots             Bot[]
  knowledgeSources KnowledgeSource[]
  leads            Lead[]
  handoffRequests  HandoffRequest[]
}

model Bot {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id])
  slug             String
  name             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  config           BotConfig?
  conversations    Conversation[]
  knowledgeSources KnowledgeSource[]
  toolExecutions   ToolExecution[]

  @@unique([businessId, slug])
}

model BotConfig {
  id              String   @id @default(cuid())
  botId           String   @unique
  bot             Bot      @relation(fields: [botId], references: [id])
  businessName    String
  industry        String?
  tone            String   @default("helpful and concise")
  goals           Json
  websiteUrl      String?
  enabledTools    Json
  rules           Json
  handoffTriggers Json
  requiredFields  Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Conversation {
  id              String            @id @default(cuid())
  botId           String
  bot             Bot               @relation(fields: [botId], references: [id])
  externalUserId  String?
  pageUrl         String?
  status          ConversationStatus @default(OPEN)
  state           Json              @default("{}")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        Message[]
  toolExecutions  ToolExecution[]
  leads           Lead[]
  handoffRequests HandoffRequest[]

  @@index([botId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           MessageRole
  content        String
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model KnowledgeSource {
  id          String           @id @default(cuid())
  businessId  String
  business    Business         @relation(fields: [businessId], references: [id])
  botId       String?
  bot         Bot?             @relation(fields: [botId], references: [id])
  type        KnowledgeSourceType
  uri         String
  title       String?
  status      IngestionStatus  @default(PENDING)
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  chunks      KnowledgeChunk[]

  @@index([businessId, botId])
}

model KnowledgeChunk {
  id        String                      @id @default(cuid())
  sourceId  String
  source    KnowledgeSource             @relation(fields: [sourceId], references: [id])
  content   String
  metadata  Json                        @default("{}")
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                    @default(now())

  @@index([sourceId])
}

model ToolExecution {
  id             String       @id @default(cuid())
  botId          String
  bot            Bot          @relation(fields: [botId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  toolName       String
  input          Json
  output         Json?
  status         ToolExecutionStatus @default(PENDING)
  error          String?
  requiresConfirmation Boolean @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([botId, conversationId, createdAt])
}

model Lead {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  name           String?
  email          String?
  phone          String?
  message        String?
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([businessId, createdAt])
}

model HandoffRequest {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id])
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  reason         String
  status         HandoffStatus @default(OPEN)
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([businessId, status, createdAt])
}

enum ConversationStatus {
  OPEN
  HANDED_OFF
  CLOSED
}

enum MessageRole {
  system
  user
  assistant
  tool
}

enum KnowledgeSourceType {
  website
  document
  faq
  text
}

enum IngestionStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ToolExecutionStatus {
  PENDING
  SUCCEEDED
  FAILED
  BLOCKED
}

enum HandoffStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}
