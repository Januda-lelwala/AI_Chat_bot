NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot?schema=public
REDIS_URL=redis://localhost:6379

# Chat model provider: openai, anthropic, or openrouter
LLM_PROVIDER=openai
LLM_MAX_TOKENS=1024

# Embeddings power pgvector knowledge search. Use "none" to run chat without vector search.
EMBEDDING_PROVIDER=openai

OPENAI_API_KEY=sk-change-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

ANTHROPIC_API_KEY=sk-ant-change-me
ANTHROPIC_MODEL=claude-3-5-haiku-latest

OPENROUTER_API_KEY=sk-or-change-me
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=AI Chatbot Backend

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=chatbot-assets
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123
